NODE_ENV=development
PORT=3000
# Default ignores forwarding headers. Set 1 only for a verified single ingress proxy.
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://localhost:5173
# Replace credentials locally; URL-encode reserved characters in passwords.
# Runtime: restricted account, no UPDATE/DELETE on salary_records.
DATABASE_URL=mysql://salary_app:REPLACE_LOCALLY@127.0.0.1:3306/salary_management_dev
# Prisma migrations/seed only: owner of the same explicitly selected schema.
MIGRATION_DATABASE_URL=mysql://salary_owner:REPLACE_LOCALLY@127.0.0.1:3306/salary_management_dev
# Seed refuses nonempty application tables. Explicitly acknowledge target by name.
SEED_DATABASE_NAME=salary_management_dev
SEED_HR_EMAIL=hr@example.test
SEED_HR_PASSWORD=
# Optional dedicated migrated test database. Never point this at production.
# Test owner: fixture setup and cleanup only.
TEST_DATABASE_URL=
TEST_DATABASE_NAME=

# Restricted account scoped only to the same isolated test schema.
TEST_RUNTIME_DATABASE_URL=
