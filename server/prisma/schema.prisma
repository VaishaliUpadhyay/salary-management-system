generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

model Department {
  id           Int           @id @default(autoincrement()) @db.UnsignedInt
  code         String        @unique @db.VarChar(30)
  name         String        @unique @db.VarChar(100)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  designations Designation[]

  @@map("departments")
}

model Designation {
  id           Int        @id @default(autoincrement()) @db.UnsignedInt
  departmentId Int        @map("department_id") @db.UnsignedInt
  code         String     @unique @db.VarChar(30)
  name         String     @db.VarChar(100)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employees    Employee[]

  @@unique([departmentId, name])
  @@map("designations")
}

model Country {
  id        Int        @id @default(autoincrement()) @db.UnsignedInt
  code      String     @unique @db.Char(2)
  name      String     @unique @db.VarChar(100)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  employees Employee[]

  @@map("countries")
}

model Currency {
  code          String         @id @db.Char(3)
  name          String         @db.VarChar(100)
  isActive      Boolean        @default(true) @map("is_active")
  salaryRecords SalaryRecord[]
  exchangeRates ExchangeRate[]

  @@map("currencies")
}

model Employee {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  employeeCode  String         @unique @map("employee_code") @db.VarChar(50)
  name          String         @db.VarChar(150)
  email         String         @db.VarChar(254)
  designationId Int            @map("designation_id") @db.UnsignedInt
  countryId     Int            @map("country_id") @db.UnsignedInt
  hireDate      DateTime       @map("hire_date") @db.Date
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  designation   Designation    @relation(fields: [designationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  country       Country        @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salaryRecords SalaryRecord[]

  @@index([isActive, id])
  @@index([countryId, isActive, id])
  @@index([designationId, isActive, id])
  @@index([name, id])
  @@map("employees")
}

model SalaryRecord {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  employeeId    Int      @map("employee_id") @db.UnsignedInt
  amount        Decimal  @db.Decimal(15, 2)
  currencyCode  String   @map("currency_code") @db.Char(3)
  effectiveDate DateTime @map("effective_date") @db.Date
  createdBy     Int      @map("created_by") @db.UnsignedInt
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currency      Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  creator       User     @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([employeeId, effectiveDate])
  @@index([currencyCode])
  @@index([createdBy])
  @@map("salary_records")
}

model ExchangeRate {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  currencyCode  String   @map("currency_code") @db.Char(3)
  effectiveDate DateTime @map("effective_date") @db.Date
  unitsPerUsd   Decimal  @map("units_per_usd") @db.Decimal(24, 12)
  source        String   @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  currency      Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@unique([currencyCode, effectiveDate])
  @@map("exchange_rates")
}

model User {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  email         String         @unique @db.VarChar(254)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  salaryRecords SalaryRecord[]
  sessions      Session[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    Int      @map("user_id") @db.UnsignedInt
  csrfToken String   @map("csrf_token") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
